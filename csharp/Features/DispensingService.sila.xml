    </Command>
    <Command>
        <Identifier>SetFillVolume</Identifier>
        <DisplayName>Set Liquids Fill Volumes</DisplayName>
        <Description>
            Sets the fill volume for the specified liquid class. The fill volume determines how much liquid is dispensed
            when the liquid class is used in a Transfer Liquid and Dispense Protocol command.
            It helps calculate the time required to dispense a given volume of liquid. The fill volume is influenced by the liquid class and the source plate used, and is measured in microliters (µL).
        </Description>
        <Observable>Yes</Observable>
        <Parameter>
            <Identifier>FillVolumes</Identifier>
            <DisplayName>Fill volumes</DisplayName>
            <Description>
                An XML formatted array of fill volume parameters describes the fill volume XML Schema.

                Below is a valid example of the fill volume parameter XML Schema. To use it, remove the comment markup enclosing the example and the "/" within some of the elements.

                If the Source Well is not defined, the FillVolume_µL for the specified liquid name will be used for all wells in the source plate.
                <!--
<?xml version="1.0" encoding="utf-8"?>
<FillVolumeSchema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <SourcePlateType>
        <String>S.100 Plate</String>
    </SourcePlateType>
    <ArrayOfFillVolumes>
        <FillVolume>
            <FillVolumeParameter Name="LiquidName">
                <String>Water</String>
            </FillVolumeParameter>
            <FillVolumeParameter Name="FillVolume_µL">
                <Int>10</Int>
            </FillVolumeParameter>
        </FillVolume>
        <FillVolume>
            <FillVolumeParameter Name="LiquidName">
                <String>VSCY 2.0 mPa*s (DMSO)</String>
            </FillVolumeParameter>
            <FillVolumeParameter Name="FillVolume_µL">
                <Int>10</Int>
            </FillVolumeParameter>
        </FillVolume>
    </ArrayOfFillVolumes>
</FillVolumeSchema>
                -->
            </Description>
            <DataType>
                <Basic>String</Basic>
            </DataType>
        </Parameter>
    </Command>

    <Command>
        <Identifier>DropDetectionResult</Identifier>
        <DisplayName>Drop Detection Result</DisplayName>
        <Description>
            Retrieves drop detection results from the most recent DispenseProtocol command run.
            Each result contains the source well, target well, detected drop count, and target drop count for every dispensing step.
            Returns an empty list if no dispense run has been executed since startup.
            Note that the TransferLiquid commands do not produce drop detection results. Refer to the response of the TransferLiquid command for those dispensing details.
        </Description>
        <Observable>No</Observable>
        <Response>
            <Identifier>DropDetectionResults</Identifier>
            <DisplayName>Drop Detection Results</DisplayName>
            <Description>List of drop detection results.</Description>
            <DataType>
                <List>
                    <DataType>
                        <DataTypeIdentifier>DropDetectionResult</DataTypeIdentifier>
                    </DataType>
                </List>
            </DataType>
        </Response>
    </Command>
    <DataTypeDefinition>
        <Identifier>DropDetectionResult</Identifier>
        <DisplayName>Drop Detection Result</DisplayName>
        <Description>Drop detection result for a single dispensing step.</Description>
        <DataType>
            <Structure>
                <Element>
                    <Identifier>SourceWell</Identifier>
                    <DisplayName>Source Well</DisplayName>
                    <Description>Name/identifier of the source well (e.g., "A1", "B2").</Description>
                    <DataType>
                        <Basic>String</Basic>
                    </DataType>
                </Element>
                <Element>
                    <Identifier>TargetWell</Identifier>
                    <DisplayName>Target Well</DisplayName>
                    <Description>Name/identifier of the target well (e.g., "A1", "B2").</Description>
                    <DataType>
                        <Basic>String</Basic>
                    </DataType>
                </Element>
                <Element>
                    <Identifier>DetectedDropCount</Identifier>
                    <DisplayName>Detected Drop Count</DisplayName>
                    <Description>Number of drops detected by the drop detection system for this dispensing step.
                    </Description>
                    <DataType>
                        <Basic>Integer</Basic>
                    </DataType>
                </Element>
                <Element>
                    <Identifier>TargetDropCount</Identifier>
                    <DisplayName>Target Drop Count</DisplayName>
                    <Description>Target number of drops that should have been dispensed to this dispensing step.
                    </Description>
                    <DataType>
                        <Basic>Integer</Basic>
                    </DataType>
                </Element>
                <Element>
                    <Identifier>DetectedVolume</Identifier>
                    <DisplayName>Detected Volume</DisplayName>
                    <Description>Dispensed volume calculated from the detected drop count for this dispensing step.
                    </Description>
                    <DataType>
                        <Constrained>
                            <DataType>
                                <Basic>Real</Basic>
                            </DataType>
                            <Constraints>
                                <Unit>
                                    <Label>nL</Label>
                                    <Factor>0.000000000001</Factor>
                                    <Offset>0</Offset>
                                    <UnitComponent>
                                        <SIUnit>Meter</SIUnit>
                                        <Exponent>1</Exponent>
                                    </UnitComponent>
                                    <UnitComponent>
                                        <SIUnit>Meter</SIUnit>
                                        <Exponent>1</Exponent>
                                    </UnitComponent>
                                    <UnitComponent>
                                        <SIUnit>Meter</SIUnit>
                                        <Exponent>1</Exponent>
                                    </UnitComponent>
                                </Unit>
                            </Constraints>
                        </Constrained>
                    </DataType>
                </Element>
                <Element>
                    <Identifier>TargetVolume</Identifier>
                    <DisplayName>Target Volume</DisplayName>
                    <Description>Total Volume that should have been dispensed to this dispensing step.</Description>
                    <DataType>
                        <Constrained>
                            <DataType>
                                <Basic>Real</Basic>
                            </DataType>
                            <Constraints>
                                <Unit>
                                    <Label>nL</Label>
                                    <Factor>0.000000000001</Factor>
                                    <Offset>0</Offset>
                                    <UnitComponent>
                                        <SIUnit>Meter</SIUnit>
                                        <Exponent>1</Exponent>
                                    </UnitComponent>
                                    <UnitComponent>
                                        <SIUnit>Meter</SIUnit>
                                        <Exponent>1</Exponent>
                                    </UnitComponent>
                                    <UnitComponent>
                                        <SIUnit>Meter</SIUnit>
                                        <Exponent>1</Exponent>
                                    </UnitComponent>
                                </Unit>
                            </Constraints>
                        </Constrained>
                    </DataType>
                </Element>
            </Structure>
        </DataType>
    </DataTypeDefinition>
    <Property>
        <Identifier>DispensingStatus</Identifier>
        <DisplayName>Dispensing Status</DisplayName>
        <Description>
            The status of the I.DOT Dispensing process. Use this property to monitor DispenseProtocol and TransferLiquid
            command call progress
            as an alternative to observable feature from both command
        </Description>
        <Observable>No</Observable>
        <DataType>
            <Basic>Boolean</Basic>
        </DataType>
    </Property>
