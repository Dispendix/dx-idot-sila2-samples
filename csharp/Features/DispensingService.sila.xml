                            <ArrayOfDispensingResult xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    							<DispensingResult>
                                <Step>1</Step>
        							<TargetDrop>3</TargetDrop>
        							<DetectedDrop>3</DetectedDrop>
        							<Timestamp>2024-04-23T15:06:53.3815922+07:00</Timestamp>
    							</DispensingResult>
    							<DispensingResult>
                                <Step>2</Step>
        							<TargetDrop>5</TargetDrop>
        							<DetectedDrop>5</DetectedDrop>
        							<Timestamp>2024-04-23T15:06:54.9375445+07:00</Timestamp>
 									</DispensingResult>
                                    <DispensingResult>
                                <Step>3</Step>
        							<TargetDrop>4</TargetDrop>
        							<DetectedDrop>4</DetectedDrop>
        							<Timestamp>2024-04-23T15:06:55.9375445+07:00</Timestamp>
